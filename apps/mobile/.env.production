# Loaded by Expo CLI when bundling in production mode (Release builds, expo export).
# eas.json's `env` only reaches EAS *cloud* builds — a local Xcode build reads this file.
# Dev is deliberately absent: without it, api.ts falls back to Metro's LAN host.
EXPO_PUBLIC_API_URL=https://save-n-spend.onrender.com/api/v1
