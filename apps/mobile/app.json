{
  "expo": {
    "name": "Save n Spend",
    "slug": "save-n-spend",
    "version": "2.0.0",
    "scheme": "savenspend",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bipsig.savenspend",
      "buildNumber": "12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A16"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Save n Spend uses Face ID to unlock your accounts and balances when you open the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9B8CFF"
        }
      ]
    ]
  }
}
