{
  "name": "@save-n-spend/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "reminders": "ts-node src/scripts/reminders.ts",
    "pretest": "node -e \"require('fs').mkdirSync('coverage', { recursive: true })\"",
    "test": "node --require ts-node/register --enable-source-maps --test --test-global-setup=test/globalSetup.cjs --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/*.test.ts' 'scripts/**/*.test.ts' 'test/**/*.test.ts' && node --require ts-node/register scripts/coverage.ts coverage/lcov.info",
    "test:coverage": "COVERAGE_GATE=1 npm test",
    "guard:contract": "node --require ts-node/register scripts/guards/contract.ts",
    "guard:replay": "node --require ts-node/register scripts/guards/replay.ts",
    "guard:golden": "node --require ts-node/register scripts/guards/golden.ts",
    "check:invariants": "node --require ts-node/register scripts/checkInvariants.ts",
    "build:category-index": "node --require ts-node/register scripts/buildCategoryIndex.ts"
  },
  "dependencies": {
    "@save-n-spend/types": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.10.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "mongodb-memory-server-core": "^11.3.0",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
